{
  "name": "reel-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-directed, deterministic, silent-first educational video production.",
  "license": "MIT",
  "engines": {"node": ">=20"},
  "scripts": {
    "setup": "node scripts/reel.mjs setup",
    "plan": "node scripts/reel.mjs plan",
    "build": "node scripts/reel.mjs build",
    "test": "node --test test",
    "check": "node --check lib/core.mjs && node --check lib/regional.mjs && node --check lib/production.mjs && node --check scripts/reel.mjs && node --check scripts/regional.mjs && node --check scripts/studio.mjs",
    "review": "node scripts/reel.mjs review",
    "regional:setup": "node scripts/regional.mjs setup",
    "regional:build": "node scripts/regional.mjs build",
    "studio": "node scripts/studio.mjs",
    "verify:delivery": "node scripts/studio.mjs review",
    "validate": "node scripts/validate.mjs",
    "intro": "node scripts/stories.mjs",
    "story": "node scripts/stories.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.537",
    "@remotion/renderer": "4.0.537",
    "ffmpeg-static": "5.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.537"
  }
}
